[Desktop Entry]
Type=Application
Name=kdock Previews
Comment=Window preview strip (Wayland layer-shell)
Exec=@CMAKE_INSTALL_FULL_BINDIR@/kdock-previews
Icon=preferences-desktop-display
Categories=Utility;
NoDisplay=true
# Both keys are mandatory and both are matched by KWin against the *absolute*
# path in Exec= (it resolves the caller's /proc/<pid>/exe through
# KApplicationTrader). Without the first there is no window list; without the
# second every CaptureWindow call comes back as
# org.kde.KWin.ScreenShot2.Error.NoAuthorized and every card falls back to the
# app icon.
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
