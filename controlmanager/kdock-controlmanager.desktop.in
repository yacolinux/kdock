[Desktop Entry]
Type=Application
Name=kdock Control Manager
Comment=Control panel: audio, brightness, media, network and system settings
Exec=@CMAKE_INSTALL_FULL_BINDIR@/kdock-controlmanager
Icon=preferences-system
Categories=Utility;
NoDisplay=true
# No X-KDE-Wayland-Interfaces / X-KDE-DBUS-Restricted-Interfaces here: the panel
# is a layer-shell surface, and zwlr_layer_shell_v1 is *not* on KWin's
# restricted-interface list (verified with wayland-info). The entry exists so the
# settings dialog carries a name and an icon in the task switcher, and so a KWin
# rule has an app id to match.
