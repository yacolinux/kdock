[Desktop Entry]
Type=Application
Name=kdock-weather
GenericName=Weather
Comment=El clima de kdock: condición actual y pronóstico
Exec=@CMAKE_INSTALL_FULL_BINDIR@/kdock-weather
Icon=weather-few-clouds
Categories=Utility;
NoDisplay=true
# No X-KDE-Wayland-Interfaces / X-KDE-DBUS-Restricted-Interfaces here: this
# binary asks the compositor for nothing privileged (its window is an ordinary
# toplevel). The entry exists so the window carries a name and an icon in the
# task switcher, and so a KWin rule has an app id to match.
